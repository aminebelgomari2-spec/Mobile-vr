<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Mobile VR - Tout en un</title>
  <style>
    body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #000; font-family: sans-serif; }
    #vr-container { width: 100vw; height: 100vh; }
    #ui { position: absolute; top: 20px; left: 50%; transform: translateX(-50%); z-index: 10; display: flex; gap: 10px; }
    button { padding: 12px 20px; font-size: 16px; border-radius: 8px; border: none; background: #007bff; color: white; font-weight: bold; cursor: pointer; }
  </style>

  <!-- Chargement des bibliothèques via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/effects/StereoEffect.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
</head>
<body>

  <div id="ui">
    <button id="start-btn">Démarrer Mode VR & Mains</button>
    <button id="joycon-btn">Connecter Joy-Con</button>
  </div>
  
  <video id="webcam" playsinline style="display:none;"></video>
  <div id="vr-container"></div>

  <script>
    let scene, camera, renderer, effect;
    let handJoints = [];

    const startBtn = document.getElementById('start-btn');
    const joyconBtn = document.getElementById('joycon-btn');
    const video = document.getElementById('webcam');

    // --- 1. CONFIGURATION DU MONDE 3D (THREE.JS) ---
    function initVR() {
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 1.6, 0);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      document.getElementById('vr-container').appendChild(renderer.domElement);

      // Effet stéréoscopique pour casque VR
      effect = new THREE.StereoEffect(renderer);
      effect.setSize(window.innerWidth, window.innerHeight);

      // Lumière et Grille au sol
      scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 1));
      scene.add(new THREE.GridHelper(20, 20));

      // Création de 21 billes vertes pour représenter la main
      for (let i = 0; i < 21; i++) {
        const joint = new THREE.Mesh(
          new THREE.SphereGeometry(0.02, 8, 8),
          new THREE.MeshBasicMaterial({ color: 0x00ff00 })
        );
        handJoints.push(joint);
        scene.add(joint);
      }

      // Gyroscope du téléphone pour tourner la tête en VR
      window.addEventListener('deviceorientation', (e) => {
        if (!e.alpha) return;
        const alpha = THREE.MathUtils.degToRad(e.alpha);
        const beta = THREE.MathUtils.degToRad(e.beta);
        const gamma = THREE.MathUtils.degToRad(e.gamma);
        camera.rotation.set(beta, alpha, -gamma, 'YXZ');
      });

      animate();
    }

    function animate() {
      requestAnimationFrame(animate);
      effect.render(scene, camera);
    }

    // --- 2. CONFIGURATION SUIVI DE MAIN (MEDIAPIPE) ---
    function initHandTracking() {
      const hands = new Hands({
        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
      });

      hands.setOptions({ maxNumHands: 1, modelComplexity: 1, minDetectionConfidence: 0.5 });
      
      hands.onResults((results) => {
        if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
          const landmarks = results.multiHandLandmarks[0];
          landmarks.forEach((pt, i) => {
            // Positionne le squelette devant la caméra VR
            handJoints[i].position.set((pt.x - 0.5) * 2, -(pt.y - 0.5) * 2 + 1.5, -pt.z - 0.5);
          });
        }
      });

      const cameraUtils = new Camera(video, {
        onFrame: async () => await hands.send({ image: video }),
        width: 640, height: 480
      });
      cameraUtils.start();
    }

    // --- 3. DÉMARRAGE SUR CLIC ---
    startBtn.addEventListener('click', async () => {
      document.getElementById('ui').style.display = 'none';

      // Accès caméra arrière
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
      video.srcObject = stream;

      initVR();
      initHandTracking();
    });

    // --- 4. CONNEXION JOY-CON (WEB-HID) ---
    joyconBtn.addEventListener('click', async () => {
      try {
        const devices = await navigator.hid.requestDevice({ filters: [{ vendorId: 0x057e }] });
        if (devices.length > 0) {
          const joycon = devices[0];
          await joycon.open();
          alert("Joy-Con connecté : " + joycon.productName);
        }
      } catch (err) {
        alert("Erreur Joy-Con : " + err);
      }
    });
  </script>
</body>
</html>
